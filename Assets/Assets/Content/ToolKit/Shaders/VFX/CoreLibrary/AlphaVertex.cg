/*
Enableing vertex alpha and is using the vertex alpha from mesh texcoords3. 
*/
#ifndef FX_ALPHAVERTEX
#define FX_ALPHAVERTEX

inline half4 AlphaVertex(in half4 inColor, in half disable, in float inTexcoords)
{
    return half4(inColor.rgb, lerp(inTexcoords * inColor.a, inColor.a, disable));
}

#endif
